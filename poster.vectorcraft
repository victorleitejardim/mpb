edged bed stays below 1 mg C mâ»Â² until May.","style":{"font_family":"Helvetica","font_style":"Regular","size":22.5,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"cmyk","c":0.0,"m":0.0,"y":0.0,"k":0.0}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}}],"para":{"justify":"Left","left_indent":0.0,"right_indent":0.0,"first_line_indent":0.0,"space_before":0.0,"space_after":0.0,"hyphenate":false}}},{"id":521,"kind":{"type":"text","kind":{"kind":"area","frame":{"subpaths":[{"anchors":[{"p":[-3.552713678800501e-15,20.48750936940266]},{"p":[590.6944547418985,20.48750936940266]},{"p":[590.6944547418985,1.1730389961587775]},{"p":[-3.552713678800501e-15,1.1730389961587775]}],"closed":true}]}},"xf":[3.864896044445265,0.0,0.0,3.8648960444452656,85.03937007874015,979.0508192049061],"runs":[{"text":"Maerl beds are ecologically important biogenic habitats formed by aggregations of free-living, non-geniculate coralline algal nodules. Microphytobenthos is thought to be a key food source in maerl-bed food webs, yet its communities had never been described. ","style":{"font_family":"Helvetica","font_style":"Regular","size":7.762175141325423,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"cmyk","c":0.8929678,"m":0.61819375,"y":0.37232438,"k":0.495364}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}},{"text":"We compared an unimpacted and a dredged bed:","style":{"font_family":"Helvetica","font_style":"Bold","size":7.762175141325423,"tracking":0.0,"baseline_shift":0.0,"h_scale":100.0,"v_scale":100.0,"rotation":0.0,"fill":{"type":"solid","color":{"model":"cmyk","c":0.8929678,"m":0.61819375,"y":0.37232438,"k":0.495364}},"stroke":{"type":"none"},"stroke_width":0.0,"underline":false,"strikethrough":false,"all_caps":false}},{"text":"